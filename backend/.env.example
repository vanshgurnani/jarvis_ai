# Server Configuration
HOST=127.0.0.1
PORT=8765
ENVIRONMENT=development
LOG_LEVEL=info
AUTH_TOKEN=friday-dev-secret-token

# LLM Provider Configuration ("custom_llm", "llama_gateway", "cloudflare_worker", "mock")
LLM_PROVIDER=custom_llm

# Custom LLM / Gateway Configuration
CUSTOM_LLM_URL=https://llama-api-gateway.onrender.com
CUSTOM_LLM_TOKEN=
CUSTOM_LLM_MODEL=@cf/meta/llama-3.2-3b-instruct

# Llama Gateway Configuration (Legacy Alias)
LLAMA_GATEWAY_URL=https://llama-api-gateway.onrender.com
LLAMA_GATEWAY_TOKEN=
LLAMA_GATEWAY_MODEL=@cf/meta/llama-3.2-3b-instruct

# Fallback direct LLM API (if needed)
FALLBACK_OPENAI_API_KEY=
FALLBACK_OPENAI_BASE_URL=https://api.openai.com/v1
FALLBACK_MODEL=gpt-4o-mini

# Database
DATABASE_URL=sqlite+aiosqlite:///friday.db

# Voice & Persona
DEFAULT_LOCALE=en-IN
ENABLE_HINGLISH=true
TTS_ENGINE=edge-tts
TTS_VOICE_HI=hi-IN-SwaraNeural
TTS_VOICE_EN=en-IN-NeerjaNeural
